        {
          "name": "List User Collections",
          "id": "a3e06e1b-74eb-4407-8346-20df5f3ea308",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/collection?editor=<string>&inc=<string>&fmt=xml",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "collection"
              ],
              "query": [
                {
                  "description": "(Required) MusicBrainz editor (username) whose collections to list.",
                  "key": "editor",
                  "value": "<string>"
                },
                {
                  "description": "Plus-separated list of sub-resources and relationships to include in the response.",
                  "key": "inc",
                  "value": "<string>"
                },
                {
                  "description": "Response serialization format. Defaults to XML; set to `json` for JSON.",
                  "key": "fmt",
                  "value": "xml"
                }
              ]
            },
            "description": "List the collections owned by a MusicBrainz editor. Use `inc=user-collections` while authenticated to also include private collections."
          },
